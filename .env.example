# Required before starting the API outside tests.
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Optional Gemini configuration. The API key is never committed.
GEMINI_API_KEY=
GEMINI_MODEL=

# PostgreSQL is required for the non-test application profile.
DATABASE_URL=jdbc:postgresql://localhost:5432/watchspaces
DATABASE_USERNAME=watchspaces
DATABASE_PASSWORD=replace-with-a-unique-local-database-password
FLYWAY_ENABLED=true
DATABASE_MAX_POOL_SIZE=20
DATABASE_MIN_IDLE=5
